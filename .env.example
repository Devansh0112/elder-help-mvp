# "openai" for real voice, "fake" to run everything (and all tests) with no key and no network.
VOICE_PROVIDER=openai
OPENAI_API_KEY=
# Leave blank to use the defaults in src/app/api/session/route.ts and src/server/conversations.ts.
OPENAI_REALTIME_MODEL=
OPENAI_SUMMARY_MODEL=
DB_PATH=data/elder-help.db
